<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Category for the module -->
    <record id="category_bookland" model="ir.module.category">
        <field name="name">Bookland Management</field>
        <field name="description">Manage books and related data.</field>
        <field name="sequence">10</field>
    </record>

    <!-- Group -->
    <record id="group_bookland_manager" model="res.groups">
        <field name="name">Bookland Manager</field>
        <field name="category_id" ref="category_bookland"/>
        <field name="comment">Users in this group can manage all books.</field>
    </record>

    <record id="group_bookland_user" model="res.groups">
        <field name="name">Bookland User</field>
        <field name="category_id" ref="category_bookland"/>
        <field name="comment">Users in this group can view and edit their own books.</field>
    </record>

    <!-- Optional: Record rules can go here too -->
    <record id="bookland_book_user_rule" model="ir.rule">
        <field name="name">Bookland: User can see own books</field>
        <field name="model_id" ref="model_bookland_book"/>
        <field name="groups" eval="[(4, ref('group_bookland_user'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

</odoo>
