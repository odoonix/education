<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="books_details_template" name="Books Details">
    <t t-call="website.layout">
        <div class="container oe_structure">
            <t t-set="bookname" t-value="'Books'"/>
            <t t-if="books and len(books)&gt;5">
                <h1>
                    <span t-out="bookname"/>
                </h1>
            </t>
            <t t-elif="books and len(books)&lt;5 and len(books)&gt;=3">
                <h1>
                    Book
                </h1>
            </t>
            <t t-else="">
                <h1>
                    Nothing
                </h1>
            </t>

            <!-- <t t-set="foo">
                <li>ok</li>
                <li>ok</li>
                <li>ok</li>
                <li>ok</li>
            </t>
            <t t-out="foo"/> -->

            <div class="container my-4">
                <div class="d-flex flex-wrap justify-content-start gap-3">
                    <t t-set="counter" t-value="0"/>
                    <t t-foreach="books" t-as="book">
                        <div class="card" style="width: 18rem;">
                            <img class="card-img-top"
                                 t-attf-src="data:image/png;base64,{{book.image_1920}}"
                                 alt="Book cover"/>
                            <div class="card-body">
                                <h5 class="card-title">
                                    <span t-out="book.name"/>
                                </h5>
                                <p class="card-text">
                                    <span t-out="book.description"/>
                                </p>
                                <a href="#" t-attf-class="btn btn-{{'primary' if int(book.id) % 2 == 0 else 'secondary'}}">
                                    <t t-out="'Button' + str(counter)"/>
                                    <t t-set="counter" t-value="counter+1"/>
                                </a>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>
</template>

</odoo>