# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=fastapi_app
POSTGRES_HOST=db
POSTGRES_PORT=5432

# FastAPI
APP_NAME=FastAPI Odoo Service
APP_ENV=development
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+psycopg2://app:app@db:5432/fastapi_app
API_HOST=0.0.0.0
API_PORT=8000

# Odoo
ODOO_HOST=odoo
ODOO_PORT=8069
ODOO_DB=odoo
ODOO_USER=admin
ODOO_PASSWORD=admin
ODOO_MASTER_PASSWORD=odoo

# Odoo Postgres (separate database on same server)
ODOO_PG_USER=odoo
ODOO_PG_PASSWORD=odoo
ODOO_PG_DB=postgres
