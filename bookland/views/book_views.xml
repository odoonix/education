<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Book Form -->
    <record id="book_form_view" model="ir.ui.view">
        <field name="name">Book Form</field>
        <field name="model">bookland.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <group>
                    <group name="general">
                        <field name="name" />
                    </group>
                    <group name="publication">
                        <field name="publish_date" />
                    </group>
                    <group name="price">
                        <field name="price" />
                        <field name="currency_id" />
                    </group>

                    <group name="isbn">
                        <field name="isbn" />
                    </group>
                    <group name="quantity">
                        <field name="quantity" />
                    </group>
                    <group name="Language">
                        <field name="language_id" />
                    </group>
                    <group name="author_ids">
                        <field name="author_ids" />
                    </group>
                </group>
                <notebook>
                    <page name="description" string="Description">
                        <field name="description" />
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <!-- Book List -->

    <record id="book_list_view" model="ir.ui.view">
        <field name="name">Book List</field>
        <field name="model">bookland.book</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="publish_date" />
                <field name="price" />
                <field name="currency_id" invisible="1" />
                <field name="language_id" />
            </tree>
        </field>
    </record>

    <!-- Book Action -->

    <record id="books_list_action" model="ir.actions.act_window">
        <field name="name">Book List</field>
        <field name="res_model">bookland.book</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Book Menu -->

    <record id="main_menu" model="ir.ui.menu">
        <field name="name">Bookland</field>
        <field name="sequence" eval="16" />
    </record>

    <record id="books_list_menu" model="ir.ui.menu">
        <field name="name">Books</field>
        <field name="parent_id" ref="bookland.main_menu" />
        <field name="action" ref="bookland.books_list_action" />
        <field name="sequence" eval="16" />
    </record>

</odoo>
